# ============================================================
# ScholarPilot AI — Backend API environment (example)
# Copy to .env and fill real values. NEVER commit .env.
# ============================================================

# --- App ---
NODE_ENV=development
PORT=4000

# --- Database (matches docker-compose) ---
DATABASE_URL="postgresql://scholarpilot:scholarpilot@localhost:5432/scholarpilot?schema=public"

# --- Redis (queue / cache / rate-limit) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- Email (verification / reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ScholarPilot AI <noreply@scholarpilot.ai>"

# --- Vector DB (Qdrant) ---
QDRANT_URL=http://localhost:6333

# --- Search (Meilisearch) ---
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=scholarpilot_dev_key

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=scholarpilot
S3_SECRET_KEY=scholarpilot123
S3_BUCKET=scholarpilot
S3_REGION=us-east-1

# --- AI providers (paid usage — keep server-side only) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Frontend origin (CORS) ---
FRONTEND_URL=http://localhost:3100
ADMIN_URL=http://localhost:3200
